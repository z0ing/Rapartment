# 基础设施密钥模板：clone 后复制为 deploy/.env 并填真实值（.env 已被 .gitignore 忽略）
# docker compose 只自动加载与 compose 文件同目录的 .env，无需 --env-file
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# 后端密钥不在此文件（Java 进程读不到 deploy/.env）：
#   jwt.secret            -> web/web-admin/src/main/resources/application-local.yml
#   aliyun.sms.access-key -> web/web-app/src/main/resources/application-local.yml（走 mock 时留空）
# 库名 rapartment、bucket 名 rapartment、容器名属命名规范，明文写在 docker-compose.yml 里，不变量化。
